{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "profile": {
      "type": "string",
      "format": "uri"
    },
    "updated": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "excluded": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9]+$"
      },
      "uniqueItems": true
    },
    "overrides": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-9]+$"
          },
          "title": {
            "type": "string"
          },
          "author": {
            "type": "string"
          },
          "year": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2100
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "cover": {
            "type": "string",
            "format": "uri"
          }
        },
        "required": ["id"],
        "additionalProperties": false
      }
    },
    "series": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "count": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": ["name", "url"],
        "additionalProperties": false
      }
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "books": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "title": {
                  "type": "string"
                },
                "author": {
                  "type": "string"
                },
                "year": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 2100
                },
                "rating": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 5
                },
                "url": {
                  "type": "string",
                  "format": "uri"
                },
                "cover": {
                  "type": "string",
                  "format": "uri"
                },
                "series": {
                  "type": "string"
                }
              },
              "required": ["title", "author"],
              "additionalProperties": false
            }
          }
        },
        "required": ["name", "books"],
        "additionalProperties": false
      }
    }
  },
  "required": ["categories"],
  "additionalProperties": false
}
