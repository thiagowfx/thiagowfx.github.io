{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "updated": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "shows": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "years": {
            "type": "string",
            "pattern": "^[0-9]{4}(–([0-9]{4}|present))?$"
          },
          "seasons": {
            "type": "integer",
            "minimum": 1
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "cover": {
            "type": "string",
            "format": "uri"
          }
        },
        "required": ["title", "years", "seasons", "url", "cover"],
        "additionalProperties": false
      }
    }
  },
  "required": ["updated", "shows"],
  "additionalProperties": false
}
