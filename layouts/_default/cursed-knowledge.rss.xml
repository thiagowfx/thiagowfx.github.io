{{- $entries := after 1 (split .RawContent "\n## ") -}}
{{- $authorEmail := .Site.Params.author.email -}}
{{- $authorName := .Site.Params.author.name -}}
{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
{{- printf "<?xml-stylesheet type=\"text/xsl\" href=\"%srss.xsl\"?>" .Site.BaseURL | safeHTML }}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>{{ .Title }} on {{ .Site.Title }}</title>
    <link>{{ .Permalink }}</link>
    <description>{{ .Description | default "Cursed knowledge learned while building software." }}</description>
    <generator>Hugo</generator>
    <language>{{ .Site.Language.Locale }}</language>
    <managingEditor>{{ $authorEmail }} ({{ $authorName }})</managingEditor>
    <webMaster>{{ $authorEmail }} ({{ $authorName }})</webMaster>
    {{- with .Site.Copyright }}
    <copyright>{{ . }}</copyright>{{ end }}
    {{- if not .Lastmod.IsZero }}
    <lastBuildDate>{{ .Lastmod.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</lastBuildDate>{{ end }}
    {{- with .OutputFormats.Get "RSS" }}
    {{ printf "<atom:link href=%q rel=\"self\" type=%q />" .Permalink .MediaType | safeHTML }}{{ end }}
    {{- range $entries }}
      {{- $lines := split (strings.TrimSpace .) "\n" }}
      {{- $title := index $lines 0 | strings.TrimSpace }}
      {{- $content := delimit (after 1 $lines) "\n" }}
      {{- $dateMatches := findRESubmatch `(?m)^\*(\d{4}-\d{2}-\d{2})\*$` $content }}
      {{- if not $dateMatches }}
        {{- errorf "Cursed knowledge entry %q needs an italic YYYY-MM-DD date" $title }}
      {{- end }}
      {{- $date := time.AsTime (index (index $dateMatches 0) 1) }}
      {{- $content = replaceRE `(?m)^\*\d{4}-\d{2}-\d{2}\*\s*` "" $content | strings.TrimSpace }}
      {{- $permalink := printf "%s#%s" $.Permalink ($title | anchorize) }}
      {{- $description := $.RenderString (dict "display" "block") $content }}
    <item>
      <title>{{ $title }}</title>
      <link>{{ $permalink }}</link>
      <pubDate>{{ $date.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</pubDate>
      <author>{{ $authorEmail }} ({{ $authorName }})</author>
      <guid>{{ $permalink }}</guid>
      <description>{{ $description | transform.XMLEscape | safeHTML }}</description>
    </item>
    {{- end }}
  </channel>
</rss>
