{{- $index := slice -}}
{{- range .Site.RegularPages -}}
  {{- if and (eq .Type "posts") (eq .Lang $.Site.Language.Lang) (ne .Params.rss_only true) -}}
    {{- $entry := dict
      "url" .RelPermalink
      "content" ((.Content | plainify) | default "")
    -}}
    {{- $index = $index | append $entry -}}
  {{- end -}}
{{- end -}}
{{- $index | jsonify -}}
